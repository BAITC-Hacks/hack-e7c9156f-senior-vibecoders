LLM_PROVIDER=openai
OPENAI_API_KEY=
NVIDIA_API_KEY=

# модели: быстрая — извлечение/классификация, сильная — критик/заключение
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_STRONG=gpt-5.4
OPENAI_EMBED_MODEL=text-embedding-3-small
NVIDIA_MODEL=

# кэш ответов LLM на диске (повторные прогоны бесплатны)
AI_CACHE_DIR=.cache
